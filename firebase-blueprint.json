{
  "entities": {
    "Conversation": {
      "title": "Conversation",
      "description": "A chat session between a user and Hosny",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who owns the chat" },
        "title": { "type": "string", "description": "Summary of the conversation" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a conversation",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "createdAt"]
    }
  },
  "firestore": {
    "conversations": {
      "schema": "Conversation",
      "description": "Root collection for all conversations"
    },
    "conversations/{conversationId}/messages": {
      "schema": "Message",
      "description": "Messages inside a specific conversation"
    }
  }
}
